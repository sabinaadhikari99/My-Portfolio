# Neon Postgres connection string (used by the contact form to store messages).
# Get it from https://console.neon.tech -> your project -> Connection string
# The site works without this; the contact form falls back to a mailto prompt.
DATABASE_URL=

# Public site URL, used for SEO metadata / Open Graph absolute URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# GitHub token for the live repositories section. Optional: without it the
# API is called unauthenticated (60 requests/hour per IP) and falls back to
# the snapshot in content/profile.ts when rate-limited. A fine-grained token
# with no permissions is enough for public data and raises the limit to 5,000/h.
# Create one at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
